# =======================================================
# ChatNVK Multi-Model AI & System Configuration
# =======================================================

# DEFAULT_AI_MODEL: Sets the default active AI model.
# Options: "gemini-3.5-flash", "gemini-3.5-pro", "gemini-2.5-flash",
#          "gpt-4o", "gpt-4o-mini", "o3-mini",
#          "claude-3-5-sonnet-20241022", "claude-3-5-haiku-20241022",
#          "deepseek-chat", "deepseek-reasoner",
#          "llama-3.3-70b-versatile",
#          "ollama/llama3", "custom/http-endpoint"
DEFAULT_AI_MODEL="gemini-3.5-flash"

# Google Gemini API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OpenAI API Key (Optional - for GPT-4o, GPT-4o-mini, o3-mini)
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Anthropic Claude API Key (Optional - for Claude 3.5 Sonnet & Haiku)
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# DeepSeek API Key (Optional - for DeepSeek V3 & R1)
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"

# Groq API Key (Optional - for LPU-accelerated Llama 3.3 70B)
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# Custom OpenAI-Compatible Base URL (Optional - for Ollama, LM Studio, vLLM)
CUSTOM_LLM_URL="http://localhost:11434/v1"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
